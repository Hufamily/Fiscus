    "search": "tsx services/ingestion/embeddings/src/cli.ts search"
  },
  "devDependencies": {
    "@types/pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
