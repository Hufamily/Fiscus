{
  "name": "fiscus",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic financial-document memory layer for nonprofit volunteers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "db:migrate": "bash db/migrate.sh",
    "db:seed": "tsx db/seed.ts",
    "template:generate": "tsx services/ingestion/template-gen/src/cli.ts generate",
    "template:approve": "tsx services/ingestion/template-gen/src/cli.ts approve",
    "embed:file": "tsx services/ingestion/embeddings/src/cli.ts embed",
    "search": "tsx services/ingestion/embeddings/src/cli.ts search",
    "agent:ask": "tsx services/agent/src/cli.ts ask",
    "summary:generate": "tsx services/api/summaries/src/cli.ts generate",
    "api:serve": "tsx services/api/server.ts",
    "extract:file": "tsx services/ingestion/s3-extraction/src/cli.ts extract",
    "upload:create": "tsx services/ingestion/s3-extraction/src/cli.ts create-upload"
  },
  "devDependencies": {
    "@types/pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
