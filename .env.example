# CockroachDB Cloud connection string used by the migration runner and services.
COCKROACH_DATABASE_URL=

# CockroachDB Cloud Managed MCP Server — used by services/agent for read-only
# queries in place of `pg` (see AGENTS.md §3/§6). Leave COCKROACH_MCP_API_KEY
# blank to keep the agent on the `pg` pool for reads (current default);
# writes always go through `pg` + lib/audit.ts regardless of this setting.
# The key must be a CockroachDB Cloud SERVICE ACCOUNT key scoped to mcp:read
# only (never mcp:write) — generate it in the Cloud console, never hardcode
# it here or anywhere in source.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=

# AWS region shared by the ingestion and agent services.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock vision-capable model identifier used by A2's extraction Lambda.
# Use DISABLED until you confirm available Free Tier credits; Bedrock
# inference is metered. See services/ingestion/s3-extraction/COST-GUARD.md.
BEDROCK_MODEL_ID=DISABLED
