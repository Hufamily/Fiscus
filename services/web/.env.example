# Set to "false" once services/api is reachable to use real endpoints instead of the mock layer.
VITE_USE_MOCK=true

# Base URL for the real API (e.g. http://localhost:8080/api or https://api.fiscus.example.com/api).
# Only used when VITE_USE_MOCK=false. If unreachable, the client falls back to mock data
# and shows a dismissible "Live API unreachable" banner.
VITE_API_BASE_URL=
